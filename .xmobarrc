-- weather stations : http://weather.rap.ucar.edu/surface/stations.txt
-- font awesome - arch linux package : ttf-font-awesome
Config
       { font = "xft:xos4 Terminus-11"
       , additionalFonts = [ "xft:FontAwesome-9" ]
       , borderColor = "black"
       , border = TopB
       , bgColor = "black"
       , fgColor = "#586e75"
       , alpha = 100
       , position = Top
       , textOffset = 0
       , iconOffset = 2
       , lowerOnStart = True
       , pickBroadest = False
       , persistent = False
       , hideOnStart = False
       , iconRoot = "."
       , allDesktops = True
       , overrideRedirect = True
       , commands = 
            [ Run Weather "EDDP"
                [ "-t", "<fc=#93a1a1><fn=1>\xe302</fn>  <weather> <tempC>°C</fc>"
                , "-L", "18"
                , "-H", "25"
                , "--low", "#93a1a1"
                , "--normal", "#93a1a1"
                , "--high", "#93a1a1"
                ] 36000
            , Run Battery
                [ "-t", "<fc=#b58900><acstatus></fc>"
                , "-L", "20"
                , "-H", "85"
                , "-l", "#dc322f"
                , "-n", "#b58900"
                , "-h", "#b58900"
                , "--" -- battery specific options
                -- discharging status
                , "-o"  , "<fn=1>\xf242</fn> <left>% (<timeleft>) <watts>"
                -- AC "on" status
                , "-O"  , "<fn=1>\xf1e6</fn> <left>%"
                -- charged status
                , "-i"  , "<fn=1>\xf1e6</fn> <left>%"
                , "--off-icon-pattern", "<fn=1>\xf1e6</fn>"
                , "--on-icon-pattern", "<fn=1>\xf1e6</fn>"
                ] 10
            , Run Date "<fc=#268bd2><fn=1>\xf073</fn> %a %_d %b %Y | d.%j w.%W</fc>     <fc=#FC6A03><fn=1></fn> %H:%M:%S</fc>" "date" 10
            , Run Com "status-vol" [] "vol" 5
            , Run Com "xgem" [] "gem" 10
            , Run Com "/home/bendo/.local/bin/status-spotify" [] "music" 10
            , Run XMonadLog
            ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = " %XMonadLog% } %music% {%gem%     %vol%     %date%     %EDDP%"
       }
