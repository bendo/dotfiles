#!/bin/bash

# Prefer a playing player over a paused one, with cliamp winning ties.
player=""
paused_player=""
for candidate in cliamp spotify; do
    status=$(playerctl -p "$candidate" status 2>/dev/null) || continue
    case "$status" in
        Playing) player="$candidate"; break ;;
        Paused) [[ -n "$paused_player" ]] || paused_player="$candidate" ;;
    esac
done
player=${player:-$paused_player}
[[ -n "$player" ]] || exit 0

case "$player" in
    cliamp) icon="♪" ;;
    spotify) icon="<fn=1></fn>" ;;
esac
 
bar_length=20
title_length=30
bar_icons="#."
 
data=$(playerctl -p "$player" metadata --format "{{ status }}: {{ artist }} - {{ title }}" 2>/dev/null) || exit 0
if (( ${#data} > title_length )); then
    data="${data:0:title_length-1}…"
fi
position_formatted=$(playerctl -p "$player" metadata --format "- {{ duration(position)}}" 2>/dev/null) || exit 0
length_formatted=$(playerctl -p "$player" metadata --format "{{duration(mpris:length)}}" 2>/dev/null) || exit 0
 
position=$(playerctl -p "$player" metadata --format "{{position}}" 2>/dev/null) || exit 0
length=$(playerctl -p "$player" metadata "mpris:length" 2>/dev/null) || exit 0

# Track metadata can briefly be unavailable while the player changes tracks.
[[ "$position" =~ ^[0-9]+$ && "$length" =~ ^[0-9]+$ ]] || exit 0
position=$((10#$position))
length=$((10#$length))
(( length > 0 )) || exit 0
(( position > length )) && position=$length
 
progress=$((bar_length * position / length))
 
bar="["
for i in $(seq 1 $progress);
do
    bar+=${bar_icons:0:1}
done
for i in $(seq $((progress+1)) $bar_length);
do
    bar+=${bar_icons:1:1}
done
bar+="]"
 
echo "$icon  $data $position_formatted $bar $length_formatted"
